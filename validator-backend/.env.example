# --- Required ---
# PostgreSQL connection string (lib/pq format). Used by BOTH binaries.
DATABASE_URL=postgres://validator:validator@localhost:5432/validator?sslmode=disable

# Yutori API key (X-API-Key). Used by the WORKER (Research + Scouting APIs).
YUTORI_API_KEY=

# --- Public API Surface (cmd/api) ---
# Listen address for internet-facing HTTP traffic. Spec target is :8080, but
# locally the Restate runtime already occupies :8080, so :8000 avoids a conflict
# (the Vite dev proxy targets :8000).
HTTP_ADDR=:8000

# --- Restate runtime wiring ---
# Address the Restate runtime dials to reach this deployment's services.
# Used by the WORKER (SDK deployment server).
RESTATE_DEPLOYMENT_ADDR=:9080
# Base URL of the Restate ingress the API surface calls to trigger workflows and
# forward webhooks to the worker.
RESTATE_INGRESS_URL=http://localhost:8080
# Optional bearer token if the Restate ingress requires authentication.
RESTATE_AUTH_KEY=
# Restate Cloud request-identity public key (publickeyv1_...). When set, the
# worker verifies that incoming requests are signed by your Restate Cloud
# environment. Empty = no check (local dev with self-hosted Restate).
RESTATE_IDENTITY_KEY=

# --- Webhook ingress (WORKER configures Yutori to call back here) ---
# Public base URL Yutori reaches to deliver research results and scout updates.
# The worker appends /api/webhooks/yutori (and ?aw=<awakeable> for research).
# This is REQUIRED for Day 0 setup: research results are delivered by webhook
# into a Restate awakeable, so without a public callback URL the Day 0 workflow
# fails terminally with a configuration error. For local dev use a tunnel
# (e.g. ngrok): WEBHOOK_PUBLIC_URL=https://xxxx.ngrok.app
WEBHOOK_PUBLIC_URL=

# --- Yutori tuning (WORKER) ---
YUTORI_API_BASE=https://api.yutori.com
YUTORI_TIMEOUT_SECONDS=60

# --- Mutation-eval LLM (WORKER) ---
# OpenAI-compatible chat completions endpoint used by the scout prompt-mutation
# eval. This deliberately does NOT use the Yutori Research API (paid). Works with
# OpenAI, Groq, Together, OpenRouter, or a local Ollama/vLLM OpenAI endpoint.
# Leave LLM_API_KEY empty to SKIP the mutation eval (signals still record; no
# proposals are produced).
#   OpenAI:   LLM_API_BASE=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#   Groq:     LLM_API_BASE=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Ollama:   LLM_API_BASE=http://localhost:11434/v1   LLM_MODEL=llama3.1   (LLM_API_KEY=ollama)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- Testing: minimal recurring-scout interval in seconds (WORKER) ---
# Overrides scoutingFrequencyDays so scouts deliver data quickly. 0 = use days.
SCOUT_INTERVAL_SECONDS=0
